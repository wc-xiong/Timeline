#
# 项目名称
# 
SET(WIS_PROJECT_NAME globalmodel)

INCLUDE_DIRECTORIES(
	${CMAKE_CURRENT_LIST_DIR}/../../Common
	${DIRECTXTEX_INCLUDEDIR}
	${ZIP_INCLUDEDIR}
	${OPENCV_INCLUDEDIR}
	${WINGRING_INCLUDEDIR}
	${SQLITE_INCLUDEDIR}
	${THIRDPARTY_ROOT}/openssl/inc
)

SET(OPENSSL_LIB_FILE 
	${THIRDPARTY_ROOT}/openssl/lib
)

LINK_DIRECTORIES(
	${WINGRING_LIBRARYDIR}
	${OPENCV_LIBRARYDIR}
	${ZIP_LIBRARYDIR}
	${DIRECTXTEX_LIBRARYDIR}
	${SQLITE_LIBRARYDIR}
	${OPENSSL_LIB_FILE}
)

IF(CMAKE_BUILD_TYPE STREQUAL "Debug")
	SET(OPENSSL_DLL_FILE ${THIRDPARTY_ROOT}/openssl/bin/Debug)
ELSE()
	SET(OPENSSL_DLL_FILE ${THIRDPARTY_ROOT}/openssl/bin/Release)
ENDIF()

# 拷贝dll到编译bin目录下
EXECUTE_PROCESS(COMMAND ${CMAKE_COMMAND} -E copy_directory ${OPENSSL_DLL_FILE} ${EXECUTABLE_OUTPUT_PATH})

#
# 依赖非Qt库，非本项库
#
set(DEPENDENCIES
	common
	cltlog
    )
#
# 依赖的Qt库
#
SET(QT_MODULES
	Core
	Gui
	Widgets
    )
	
