SET(SDL_HOME ${THIRDPARTY_ROOT}/SDL3 CACHE PATH "SDL_HOME dependency path" FORCE)
SET(SDL_INCLUDEDIR ${SDL_HOME}/inc)
SET(SDL_LIBRARYDIR ${SDL_HOME}/lib)
SET(SDL_EXEDIR ${SDL_HOME}/bin)

INCLUDE_DIRECTORIES(${SDL_INCLUDEDIR})
LINK_DIRECTORIES(${SDL_LIBRARYDIR})

# 拷贝dll到编译bin目录下
EXECUTE_PROCESS(COMMAND ${CMAKE_COMMAND} -E copy_directory ${SDL_EXEDIR} ${BIN_DIR})
