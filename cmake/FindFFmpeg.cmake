SET(FFMPEG_HOME ${THIRDPARTY_ROOT}/ffmpeg CACHE PATH "FFMPEG_HOME dependency path" FORCE)
SET(FFMPEG_INCLUDEDIR ${FFMPEG_HOME}/inc)
SET(FFMPEG_LIBRARYDIR ${FFMPEG_HOME}/lib)
SET(FFMPEG_EXEDIR ${FFMPEG_HOME}/bin)

INCLUDE_DIRECTORIES(${FFMPEG_INCLUDEDIR})
LINK_DIRECTORIES(${FFMPEG_LIBRARYDIR})

# 拷贝dll到编译bin目录下
EXECUTE_PROCESS(COMMAND ${CMAKE_COMMAND} -E copy_directory ${FFMPEG_EXEDIR} ${BIN_DIR})
