# OpenCV for Demuxer (MediaInfoDemuxer thumbnail via opencv_world450)
SET(OPENCV_HOME ${THIRDPARTY_ROOT}/opencv2 CACHE PATH "OPENCV_HOME dependency path" FORCE)
SET(OPENCV_INCLUDEDIR ${OPENCV_HOME}/Inc)
SET(OPENCV_LIBRARYDIR_DEBUG ${OPENCV_HOME}/lib/Debug)
SET(OPENCV_LIBRARYDIR_RELEASE ${OPENCV_HOME}/lib/Release)
SET(OPENCV_BINDIR_DEBUG ${OPENCV_HOME}/bin/Debug)
SET(OPENCV_BINDIR_RELEASE ${OPENCV_HOME}/bin/Release)

INCLUDE_DIRECTORIES(${OPENCV_INCLUDEDIR})
LINK_DIRECTORIES(${OPENCV_LIBRARYDIR_DEBUG} ${OPENCV_LIBRARYDIR_RELEASE})

# 运行时 DLL 拷到 bin（与 Timeline.exe 同目录）
IF(EXISTS "${OPENCV_BINDIR_DEBUG}/opencv_world450d.dll")
	EXECUTE_PROCESS(COMMAND ${CMAKE_COMMAND} -E copy_if_different
		"${OPENCV_BINDIR_DEBUG}/opencv_world450d.dll"
		"${BIN_DIR}/opencv_world450d.dll")
ENDIF()
IF(EXISTS "${OPENCV_BINDIR_RELEASE}/opencv_world450.dll")
	EXECUTE_PROCESS(COMMAND ${CMAKE_COMMAND} -E copy_if_different
		"${OPENCV_BINDIR_RELEASE}/opencv_world450.dll"
		"${BIN_DIR}/opencv_world450.dll")
ENDIF()
